{
  "deployment": {
    "mode": "LOCAL"
  },
  "paths": {
    "workspaceRoot": "../workspaces"
  },
  "auth": {
    "mode": "local",
    "localIdentity": {
      "tenantId": "local-tenant",
      "subjectId": "local-subject",
      "displayName": "Local developer"
    },
    "localAuth": {
      "enabled": false
    }
  },
  "channel": {
    "transport": "fastify",
    "host": "127.0.0.1",
    "port": 3000
  },
  "hostedAgent": {
    "activeAgentId": "default-agent"
  },
  "modelProfiles": [
    {
      "providerId": "openai-compatible",
      "baseUrl": "env:OPENAI_BASE_URL",
      "credentialRef": "env:OPENAI_API_KEY",
      "models": [
        {
          "modelId": "env:OPENAI_MODEL_NAME",
          "contextWindowTokens": 128000,
          "fallbackEligible": false,
          "temperature": 0.2,
          "maxOutputTokens": 2048,
          "topP": 1,
          "timeoutMs": 30000
        }
      ]
    }
  ],
  "gateway": {
    "gateways": [
      {
        "gatewayId": "local-sqlite",
        "gatewayKind": "sqlite",
        "deploymentMode": "LOCAL",
        "sqliteFileRef": "paths.sqliteFile"
      },
      {
        "gatewayId": "local-rag",
        "gatewayKind": "rag-knowledge",
        "deploymentMode": "LOCAL"
      }
    ]
  },
  "noopBoundaries": {
    "lifecycleHook": "noop",
    "checkpoint": "noop",
    "audit": "noop"
  }
}
