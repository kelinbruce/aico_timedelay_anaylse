    },
    "./local-runtime-package": {
      "types": "./dist/local-runtime-package/index.d.ts",
      "import": "./dist/local-runtime-package/index.js"
    },
    "./packaging": {
      "types": "./dist/packaging/index.d.ts",
      "import": "./dist/packaging/index.js"
    },
    "./release": {
      "types": "./dist/release/index.d.ts",
      "import": "./dist/release/index.js"
    },
    "./testing": {
