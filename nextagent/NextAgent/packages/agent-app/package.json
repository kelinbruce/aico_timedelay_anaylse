{
  "name": "@nextagent/agent-app",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entrypoints/backend-only": {
      "types": "./dist/entrypoints/backend-only.d.ts",
      "import": "./dist/entrypoints/backend-only.js"
    },
    "./entrypoints/local-configured-auth": {
      "types": "./dist/entrypoints/local-configured-auth.d.ts",
