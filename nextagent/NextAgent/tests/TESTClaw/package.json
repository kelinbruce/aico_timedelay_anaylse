{
  "name": "testclaw-test-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TESTClaw 测试框架 - 独立的 NextAgent 二进制包黑盒测试",
  "scripts": {
    "setup": "node scripts/setup-package.mjs",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "test:e2e": "npx playwright test --config tests/playwright.config.ts",
    "test:e2e:ui": "npx playwright test --config tests/playwright.config.ts --ui",
    "test:e2e:debug": "npx playwright test --config tests/playwright.config.ts --debug",
    "test:system-integration": "node scripts/run-system-integration-gate.mjs",
    "test:system-integration:sync": "node scripts/check-system-integration-source-sync.mjs",
    "test:all": "npm run test && npm run test:e2e",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tests.ps1 -All"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  }
}
