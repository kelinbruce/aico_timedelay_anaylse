    "@nextagent/agent-model": "1.0.0",
    "@nextagent/agent-channel-common": "1.0.0",
    "@nextagent/agent-channel-web": "1.0.0",
    "@nextagent/agent-plugin-sdk": "1.0.0",
    "@nextagent/agent-channel-task": "1.0.0",
    "@nextagent/agent-capability": "1.0.0",
    "@nextagent/agent-observability": "1.0.0",
    "@nextagent/agent-workflow": "1.0.0",
