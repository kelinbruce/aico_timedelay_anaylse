{
  "name": "@nextagent/agent-web",
  "version": "1.0.0-SNAPSHOT",
  "private": true,
  "type": "module",
  "description": "Telecom network agent local developer web UI",
  "scripts": {
    "dev": "vite --mode backend",
    "dev:mock": "node dev-mock.mjs",
    "mock": "cd ../agent-web-mock-server && node server.js",
    "build": "tsc --noEmit",
    "build:vite": "vite build",
    "build:vite:modes": "node scripts/build-modes.mjs",
    "build:vite:local": "vite build --mode local-auth",
    "build:vite:iam": "vite build --mode iam-only",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e:smoke",
    "test:e2e:smoke": "node scripts/run-playwright-smoke.cjs"
  },
  "dependencies": {
    "@ant-design/icons": "5.5.2",
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@antv/g6": "4.8.21",
    "antd": "5.29.3",
    "dayjs": "^1.11.21",
    "i18next": "25.8.17",
    "marked": "15.0.7",
    "mermaid": "11.15.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "15.1.2",
    "react-router-dom": "6.30.3",
    "xss": "1.0.15",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "29.0.2",
    "playwright": "1.52.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": "22.22.0"
  }
}
