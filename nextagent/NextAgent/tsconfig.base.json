{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@nextagent/agent-common": ["packages/agent-common/src/index.ts"],
      "@nextagent/agent-contracts": ["packages/agent-contracts/src/index.ts"],
      "@nextagent/agent-contracts/*": ["packages/agent-contracts/src/*/index.ts"],
      "@nextagent/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@nextagent/agent-session": ["packages/agent-session/src/index.ts"],
      "@nextagent/agent-attachment-runtime": ["packages/agent-attachment-runtime/src/index.ts"],
      "@nextagent/agent-context-engine": ["packages/agent-context-engine/src/index.ts"],
      "@nextagent/agent-memory": ["packages/agent-memory/src/index.ts"],
      "@nextagent/agent-core": ["packages/agent-core/src/index.ts"],
      "@nextagent/agent-model": ["packages/agent-model/src/index.ts"],
      "@nextagent/agent-model/testing": ["packages/agent-model/src/testing/index.ts"],
      "@nextagent/agent-channel-common": ["packages/agent-channel-common/src/index.ts"],
      "@nextagent/agent-channel-web": ["packages/agent-channel-web/src/index.ts"],
      "@nextagent/agent-dev-workbench": ["packages/agent-dev-workbench/src/index.ts"],
      "@nextagent/agent-channel-task": ["packages/agent-channel-task/src/index.ts"],
      "@nextagent/agent-channel-web-auth-local": ["packages/agent-channel-web-auth-local/src/index.ts"],
      "@nextagent/agent-app-frontend-hosting": ["packages/agent-app-frontend-hosting/src/index.ts"],
      "@nextagent/agent-platform-gateway-local": ["packages/agent-platform-gateway-local/src/index.ts"],
      "@nextagent/agent-platform-gateway-local/entrypoints/local": ["packages/agent-platform-gateway-local/src/entrypoints/local.ts"],
      "@nextagent/agent-platform-gateway-local/testing": ["packages/agent-platform-gateway-local/src/testing.ts"],
      "@nextagent/agent-platform-gateway-remote": ["packages/agent-platform-gateway-remote/src/index.ts"],
      "@nextagent/agent-remote-deployment": ["packages/agent-remote-deployment/src/index.ts"],
      "@nextagent/agent-capability": ["packages/agent-capability/src/index.ts"],
      "@nextagent/agent-observability": ["packages/agent-observability/src/index.ts"],
      "@nextagent/agent-workflow": ["packages/agent-workflow/src/index.ts"],
      "@nextagent/agent-app": ["packages/agent-app/src/index.ts"],
      "@nextagent/agent-app/local-runtime-package": ["packages/agent-app/src/local-runtime-package/index.ts"],
      "@nextagent/agent-app/release": ["packages/agent-app/src/release/index.ts"],
      "@nextagent/agent-app/testing": ["packages/agent-app/src/testing.ts"],
      "@nextagent/agent-app/*": ["packages/agent-app/src/*.ts"],
      "@nextagent/agent-plugin-sdk": ["packages/agent-plugin-sdk/src/index.ts"],
      "@nextagent/agent-plugin-sdk/scaffold": ["packages/agent-plugin-sdk/src/scaffold/index.ts"],
      "@nextagent/agent-test-kit": ["packages/agent-test-kit/src/index.ts"]
    }
  }
}
